# Ignore everything
*

# But not these files...
!.gitignore
!*.el
!*.org
!*.md
!*.go
!*.yasnippet

# ...even if they are in subdirectories
!artifacts
!custom
!langs
!mysnippets
!fundamental-mode
!org-mode
!solutions
!foreign

# foreign/magit-git2, a Zig project; its build output and measurement
# reports stay ignored
!/foreign/magit-git2/
!/foreign/magit-git2/*/
!/foreign/magit-git2/**/*.zig
!/foreign/magit-git2/**/*.zon
!/foreign/magit-git2/vendor/emacs-module.h
!/foreign/magit-git2/test/run-tests.sh
!/foreign/magit-git2/.gitattributes
!/foreign/magit-git2/LICENSE
/foreign/magit-git2/.zig-cache/
/foreign/magit-git2/zig-out*/
/foreign/magit-git2/zig-pkg/
/foreign/magit-git2/measure/report-*.org
/foreign/magit-git2/measure/*/

# CI
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

communications.el
ejc-databases.el
.mc-lists.el
